# Copy this file to .env and fill in your own values. Never commit .env.

# Database (Supabase or Neon free tier, or local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/adguard

# LLM providers (free tiers)
GEMINI_API_KEY=
GROQ_API_KEY=

# App
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Storage for uploaded product images and exported ads
UPLOAD_DIR=./uploads
